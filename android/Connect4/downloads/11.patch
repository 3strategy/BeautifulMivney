+    private void runMoveTransaction(DatabaseReference roomReference, String uid, RoomData baseline,
+                                    PendingMove operation, ResultCallback<String> callback) {
+        AtomicReference<String> rejection = new AtomicReference<>("Room changed before the move");
+        roomReference.runTransaction(new Transaction.Handler() {
+            @Override
+            public Transaction.Result doTransaction(MutableData currentData) {
+                seedEmptyTransaction(currentData, baseline);
+                MutableRoom parsed = parseMutableRoom(currentData);
+                if (parsed.error != null) {
+                    rejection.set(parsed.error);
+                    return Transaction.abort();
+                }
+                RoomData room = parsed.room;
+                RoomValidation.Result validation = parsed.validation;
+                if (!operation.expectedMoves.equals(room.getMoves())) {
+                    rejection.set("Move history changed; refresh the room");
+                    return Transaction.abort();
+                }
+                if (room.getPlayerYellow().isEmpty()) {
+                    rejection.set("Wait for a Yellow player before moving");
+                    return Transaction.abort();
+                }
+                int player = validation.getState().currentPlayer();
+                boolean ownsTurn = (player == GameState.RED && uid.equals(room.getPlayerRed()))
+                        || (player == GameState.YELLOW && uid.equals(room.getPlayerYellow()));
+                if (!ownsTurn) {
+                    rejection.set("It is not this user's turn");
+                    return Transaction.abort();
+                }
+                if (!new com.example.connect4.core.GameEngine(validation.getState())
+                        .apply(new GameAction(operation.column))) {
+                    rejection.set("That column is full or the game is finished");
+                    return Transaction.abort();
+                }
+                String newMoves = room.getMoves() + operation.column;
+                currentData.child("moves").setValue(newMoves);
+                currentData.child("updatedAt").setValue(ServerValue.TIMESTAMP);
+                rejection.set(null);
+                return Transaction.success(currentData);
+            }
+
